# ============================================================
#  client/.env.example  —  Negombo Fish Price Board (frontend)
#  Copy to client/.env. client/.env is gitignored.
# ============================================================

# Base URL of the Express API. NO TRAILING SLASH.
#   local       -> http://localhost:5000
#   production  -> https://<your-app>.up.railway.app
#
# Vite only exposes variables prefixed with VITE_, and it BAKES THEM IN
# AT BUILD TIME. If you change this on Vercel after a deploy, you must
# REDEPLOY or the built bundle keeps the old value.
VITE_API_URL=http://localhost:5000
