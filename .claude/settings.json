{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(npm run lint*)",
      "Bash(npm run type*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(python -m pytest*)",
      "Bash(pip list*)",
      "Bash(node --version*)",
      "Bash(npm --version*)",
      "Bash(python --version*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(bash .claude/hooks/git-sync-main.sh)",
      "Bash(bash .claude/hooks/deploy.sh)",
      "Read",
      "Edit",
      "Write",
      "Agent"
    ],
    "deny": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-wrap.sh\"",
            "timeout": 20,
            "statusMessage": "Checking post-session wrap-up..."
          }
        ]
      }
    ]
  }
}
