# ============================================================
#  server/.env.example  —  Negombo Fish Price Board (API)
#  Copy to server/.env and fill in the real values.
#  server/.env is gitignored. NEVER commit it.
# ============================================================

# MongoDB Atlas connection string.
# Atlas -> Connect -> Drivers -> copy, then:
#   1. replace <db_password> with the real password
#   2. put the database name (fishprice) before the "?"
#
# Shape:
# MONGO_URI=mongodb+srv://hackathon:<db_password>@cluster0.xxxxx.mongodb.net/fishprice?retryWrites=true&w=majority
MONGO_URI=

# Local port for the Express server.
# Do NOT set this on Railway — Railway injects its own PORT.
PORT=5000
